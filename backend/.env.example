# Application Settings
PROJECT_NAME="Kisan Mitra - Smart Farmer Support Platform"
APP_ENV=development
DEBUG=True
DEMO_MODE=True

# Security & Authentication
SECRET_KEY=kisan_mitra_secret_key_super_secure_change_in_production_2026_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# For MySQL: mysql+pymysql://username:password@localhost:3306/kisan_mitra
# If MySQL is unreachable, the system automatically falls back to local SQLite (sqlite:///./kisan_mitra.db)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/kisan_mitra
DB_FALLBACK_SQLITE=True

# External Services (Optional - graceful demo fallback active by default)
OPENWEATHER_API_KEY=
GEMINI_API_KEY=
AGMARKNET_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
