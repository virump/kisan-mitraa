# ============================================================
# Kisan Mitra - Backend Environment Configuration
# ============================================================

# 1. Application Settings
PROJECT_NAME="Kisan Mitra - Smart Farmer Support Platform"
APP_ENV=development
DEBUG=True
DEMO_MODE=True

# 2. Security & Authentication (JWT)
# IMPORTANT: In production, generate a strong random 32+ character key
SECRET_KEY=kisan_mitra_secret_key_super_secure_change_in_production_2026_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Database Settings
# Local SQLite: sqlite:///./kisan_mitra.db
# Render Postgres: postgres://user:password@host/dbname
# Supabase: postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# MySQL: mysql+pymysql://root:password@localhost:3306/kisan_mitra
DATABASE_URL=sqlite:///./kisan_mitra.db
DB_FALLBACK_SQLITE=True

# 4. External AI & Cloud Services (Optional)
# Google Gemini API Key for Kisan AI Chatbot (Get free at: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenWeatherMap API Key (Optional; Open-Meteo free API is used by default with zero key required)
OPENWEATHER_API_KEY=

# Agmarknet Mandi API Key (Optional; Pre-seeded authentic mandi prices are active by default)
AGMARKNET_API_KEY=

# 5. CORS Allowed Origins (Comma-separated list of frontend domains)
# Example: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
